# Copy this file to `.env` and fill in your values.
#
# Your Anthropic API key. Required.
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed when you point an agent at a GitHub repo with
# `python run.py <agent> --repo <url>`. Use a fine-grained PAT scoped to the
# target repo:
#   - "Contents: Read"            -> clone only (reviewer)
#   - "Contents: Read and write"  -> push branches / open PRs (test-writer)
# GITHUB_TOKEN=github_pat_...
